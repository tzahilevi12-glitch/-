DATABASE_URL="postgresql://postgres:postgres@localhost:5432/volunteers?schema=public"
PORT=3000
STATION_TZ=Asia/Jerusalem
# First day of the publishing week: 0 = Sunday
WEEK_START_DAY=0
# Code the shift scheduler types to sign in
COMMANDER_PIN=change-me
# Telegram push to the commanders on every volunteer sign-up (optional — leave empty to turn off).
# See DEPLOY.md, "Telegram notifications".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Shortage summary to Telegram every 2 days (see DEPLOY.md, "Weekly shortage summary")
CRON_SECRET=
# SHORTAGE_DIGEST=on
# SHORTAGE_DIGEST_HOUR=10
# SHORTAGE_DIGEST_EVERY_DAYS=2
# APP_URL=https://your-site.onrender.com
